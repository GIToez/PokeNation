# Large binary game assets go through Git LFS (GitHub rejects normal objects > 100 MB).
*.otbm filter=lfs diff=lfs merge=lfs -text
*.spr  filter=lfs diff=lfs merge=lfs -text
*.psd  filter=lfs diff=lfs merge=lfs -text

# Keep original line endings exactly as imported; do not let Git normalise them.
* -text
*.bat text eol=crlf
*.sh text eol=lf
*.ps1 text eol=crlf
*.psm1 text eol=crlf
