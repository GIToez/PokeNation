AdvanceSection < UIWidget
  height: 36
  margin-top: 4
  padding: 2
  background-color: #222833cc
  border: 1 #111111

  UIItem
    id: item
    size: 32 32
    virtual: true
    phantom: true
    anchors.left: parent.left
    anchors.verticalCenter: parent.verticalCenter
    visible: false

  UIWidget
    id: image
    size: 32 32
    phantom: true
    image-smooth: true
    anchors.left: parent.left
    anchors.verticalCenter: parent.verticalCenter
    visible: false

  Label
    id: title
    color: #b6b6b6
    text-align: center
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.right: parent.right
    margin-left: 34

  Label
    id: description
    font: sans-bold-16px
    text-align: center
    anchors.top: prev.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-left: 34

AdvancePopup < UIWidget
  width: 300
  padding: 6
  background-color: #10141bcc
  border: 1 #272727
  anchors.top: gameMapPanel.top
  anchors.horizontalCenter: gameMapPanel.horizontalCenter
  margin-top: 120
  layout:
    type: verticalBox
    fit-children: true

  UIWidget
    id: header
    height: 60
    UIWidget
      id: portrait
      size: 56 56
      anchors.left: parent.left
      anchors.verticalCenter: parent.verticalCenter
      image-smooth: true
      visible: false

    Label
      id: subtitle
      color: #ffffff
      text-align: center
      anchors.top: parent.top
      anchors.left: parent.left
      anchors.right: parent.right

    Label
      id: headline
      font: sans-bold-16px
      color: #ffd303
      text-align: center
      anchors.top: prev.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      margin-top: 8
